	(text_box "When @{\"Id\":\"YSAAIAP~{V}UJFYGIFE\",\"ObjectType\":2} conducts (V_in = Z_v + @{\"Id\":\"YSAAIAP~{V}GVPATHKK\",\"ObjectType\":2} V_eb), @{\"Id\":\"YSAAIAP~{V}GVPATHKK\",\"ObjectType\":2} starts conducting and @{\"Id\":\"YSAAIAP~{V}SMQRGIZC\",\"ObjectType\":2} turns off. May need to tune @{\"Id\":\"YSAAIAP~{V}STLYKPOP\",\"ObjectType\":2} and @{\"Id\":\"YSAAIAP~{V}TATWNWLR\",\"ObjectType\":2} for proper bias current and turn on voltage"
		(exclude_from_sim no)
		(at 81.28 29.21 0)
