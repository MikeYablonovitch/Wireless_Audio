	(text_box "Alternative device operation mode is to send stereo audio\n\nBuffer + Gain\n&\nAnti-Alias \nstages aren't populated\n\n@{\"Id\":\"JIBCZZR~{I}KRTGWUZS\",\"ObjectType\":2}\nIs populated which allows the input audio to feed straight to the ADC\nSince audio has a frequency spectrum up to 20KHz, the ADC Anti-Alias fitler is sufficient"
		(exclude_from_sim no)
		(at 312.42 -29.21 0)
		(size -119.38 40.64)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
