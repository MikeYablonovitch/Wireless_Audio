		(uuid "401b99b0-bea6-4077-bd9b-1f9fe89365cb")
	)
	(text_box "@{\"Id\":\"JIBCZZR~{I}ORPXGTXB\",\"ObjectType\":2} & @{\"Id\":\"JIBCZZR~{I}VSWOEITP\",\"ObjectType\":2} are for current limiting and help stability of OPAMP outputs. They can also be disconnected for frequency analysis of individual stages"
		(exclude_from_sim no)
		(at 254 105.41 0)
